{
  "name": "readfine",
  "version": "0.22.0",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i input.css -o backend/app/static/css/tailwind.css --minify",
    "dev": "tailwindcss -i input.css -o backend/app/static/css/tailwind.css --watch",
    "check:generated": "npm run build && git diff --exit-code backend/app/static/css/tailwind.css",
    "check:sources": "node scripts/check-tw4-classes.mjs && node scripts/check-css-vars.mjs",
    "test": "node --test tests/js/*.test.mjs",
    "test:e2e": "playwright test",
    "test:visual": "node tests/visual/run.mjs"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.5",
    "@tailwindcss/typography": "0.5.20",
    "fake-indexeddb": "6.2.7",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.3.5"
  }
}
